#!/usr/bin/bash
# 🔗 https://github.com/klapptnot/dotf

function battery_data_get {
  local key="${2}"
  case "${key}" in
    'icon_name')
      [ "${POWER_SUPPLY_STATUS}" == "Charging" ] && local icon="-charging"
      printf -v "${1}" 'battery-%03d%s' "$(((POWER_SUPPLY_CAPACITY / 10) * 10))" "${icon}"
      ;;
    'icon')
      [ "${POWER_SUPPLY_STATUS}" == "Charging" ] && printf '' && return
      case "$((POWER_SUPPLY_CAPACITY - (POWER_SUPPLY_CAPACITY % 10)))" in
      100) printf -v "${1}" '󰁹' ;;
      90)  printf -v "${1}" '󰂂' ;;
      80)  printf -v "${1}" '󰂁' ;;
      70)  printf -v "${1}" '󰂀' ;;
      60)  printf -v "${1}" '󰁿' ;;
      50)  printf -v "${1}" '󰁾' ;;
      40)  printf -v "${1}" '󰁽' ;;
      30)  printf -v "${1}" '󰁼' ;;
      20)  printf -v "${1}" '󰁻' ;;
      10)  printf -v "${1}" '󰁺' ;;
      0)   printf -v "${1}" '󰂎' ;;
      esac
      ;;
    *)
      local power_supply_key="${key^^}"
      if [ -z "${!power_supply_key@A}" ]; then
        printf 'Unknown key: %s\n' "${key^^}" >&2
        printf -v "${1}" ''
        return
      fi
      printf -v "${1}" '%s' "${!power_supply_key}"
      ;;
  esac
}

function main {
  local format_it='\{([a-z_]+)\}'
  local what="${1:-"{icon} {capacity}% {status}"}"
  local battery_file=(/sys/class/power_supply/BAT*/uevent)
  local -A batt_fields=()
  while IFS='=' read -r k v; do
    batt_fields["${k#POWER_SUPPLY_}"]="${v}"
  done < "${battery_file[0]:?no battery file found}"

  local res=''
  while [[ "${what}" =~ ${format_it} ]]; do
    battery_data_get res "${BASH_REMATCH[1]}"
    what="${what//"${BASH_REMATCH[0]}"/"${res}"}"
  done

  printf '%s\n' "${what}"
}

main "${@}"
